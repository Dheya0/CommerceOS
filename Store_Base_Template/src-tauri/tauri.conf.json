{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/toolchains/cli/schema/tauri.conf.json",
  "package": {
    "productName": "{{STORE_NAME}} - Sovereign POS",
    "version": "1.0.0"
  },
  "build": {
    "devPath": "http://localhost:3000",
    "distDir": "../dist"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "execute": true
      },
      "serial": {
        "all": true
      },
      "window": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Business",
      "copyright": "© 2026 CommerceOS Sovereign",
      "identifier": "com.commerceos.pos.{{SLUG}}",
      "icon": []
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "{{STORE_NAME}} - نقطة البيع (Desktop POS)",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
